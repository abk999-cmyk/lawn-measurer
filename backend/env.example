# Backend Configuration
# Copy this file to .env and adjust values as needed

# Google Maps API Key (REQUIRED)
# Same key used for frontend and backend
# Must have Maps JavaScript API, Places API, and Maps Static API enabled
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Path to the ML model weights file
MODEL_PATH=../model_19class.pth

# Directory where analysis outputs will be saved
OUTPUT_DIR=./outputs

# Directory for caching downloaded map images
TILE_CACHE_DIR=./tile_cache
